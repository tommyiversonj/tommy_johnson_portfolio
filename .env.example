# Get a form ID by signing up free at https://formspree.io and creating a form.
# The ID is the part after /f/ in the endpoint they give you, e.g.
# https://formspree.io/f/abcd1234 -> VITE_FORMSPREE_ID=abcd1234
VITE_FORMSPREE_ID=

# Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX. Find it in
# GA4 Admin -> Data Streams -> your web stream. Leave blank to disable —
# src/lib/analytics.js only loads gtag.js when this is set.
VITE_GA_MEASUREMENT_ID=

# Meta Pixel ID, e.g. 1234567890123456. Find it in Meta Events Manager ->
# Data Sources -> your pixel -> Settings. Leave blank to disable — the
# pixel script only loads when this is set.
VITE_META_PIXEL_ID=
